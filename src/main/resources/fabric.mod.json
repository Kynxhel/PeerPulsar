{
  "schemaVersion": 1,
  "id": "atarca",
  "version": "${version}",
  "name": "Atarca",
  "description": "Open-source peer-to-peer world hosting for Minecraft 26.3 with automatic NAT/CGNAT diagnostics, UPnP port forwarding, UDP Hole Punching, Tunnel Relay, smart room codes, and an animated neon glass UI.",
  "authors": [
    "Kynxhel"
  ],
  "contact": {
    "homepage": "https://github.com/Kynxhel/fabric-p2p-world",
    "sources": "https://github.com/Kynxhel/fabric-p2p-world",
    "issues": "https://github.com/Kynxhel/fabric-p2p-world/issues"
  },
  "license": "MIT",
  "icon": "assets/atarca/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.p2pworld.FabricP2PMod"
    ],
    "client": [
      "com.p2pworld.client.FabricP2PClient"
    ]
  },
  "mixins": [
    "atarca.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
