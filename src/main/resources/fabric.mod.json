{
  "schemaVersion": 1,
  "id": "peerpulsar",
  "version": "${version}",
  "name": "PeerPulsar",
  "description": "Open-source peer-to-peer world hosting for Minecraft 26.3 with opt-in NAT/CGNAT diagnostics, UPnP port forwarding, UDP Hole Punching, Tunnel Relay, embedded room keys, optional join approval, and configurable network services.",
  "authors": [
    "Kynxhel"
  ],
  "contact": {
    "homepage": "https://github.com/Kynxhel/PeerPulsar",
    "sources": "https://github.com/Kynxhel/PeerPulsar",
    "issues": "https://github.com/Kynxhel/PeerPulsar/issues"
  },
  "license": "MIT",
  "icon": "assets/peerpulsar/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.kynxhel.peerpulsar.PeerPulsar"
    ],
    "client": [
      "com.kynxhel.peerpulsar.client.PeerPulsarClient"
    ]
  },
  "mixins": [
    "peerpulsar.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": ">=0.165.2+26.3"
  }
}